diff --git a/app/kafka_worker.py b/app/kafka_worker.py
index 5a885fd..1c4a493 100644
--- a/app/kafka_worker.py
+++ b/app/kafka_worker.py
@@ -52,6 +52,10 @@ async def handle(raw: bytes, processor, producer):
                                      key=str(event["taskId"]).encode())
     try:
         body = json.loads(raw)
+        # Spring DB는 기계 사진을 MOTOR로 저장한다(attachment.target 규칙). 기존 계약 이름 MECHANICAL로 맞춘다
+        for a in body.get("payload", {}).get("attachments", []):
+            if a.get("target") == "MOTOR":
+                a["target"] = "MECHANICAL"
         command = BackendCommand.model_validate(body)
     except (ValueError, ValidationError) as exc:  # 깨진 JSON·계약 위반 → DLT만 (taskId를 믿을 수 없음)
         log_event("kafka.invalid_command", error_type=type(exc).__name__)
