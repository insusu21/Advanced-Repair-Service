+"""Spring 없이 Kafka 워커 시험: Spring인 척 v2 명령 1개를 넣고, 결과 이벤트를 v2 JSON Schema로 검사한다.
+
+uv run --extra live python -m app.kafka_send_test
+Spring이 없으니 사진은 app/samples 예시 2장(PCB 1, 기계 1)이 쓰인다.
+"""
+import asyncio
+import json
+import sys
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+import jsonschema
+from aiokafka import AIOKafkaConsumer, AIOKafkaProducer
+from app.kafka_worker import COMMANDS_TOPIC, EVENTS_TOPIC, KAFKA
+
+SCHEMA = json.loads(Path("tests/fixtures/backend-v2.schema.json").read_text())
+FINAL = ("DIAGNOSIS_COMPLETED", "PHOTO_REQUESTED", "DIAGNOSIS_FAILED")
+TASK = str(900 + int(datetime.now().strftime("%H%M%S")))  # 실행마다 새 작업 (SQLite가 같은 작업 재접수를 거부)
+
+
+def photo(pid, target):
+    return {"id": pid, "request_id": None, "kind": "IMAGE", "target": target, "mime_type": "image/jpeg",
+            "byte_size": 1024, "sha256": "0" * 64, "downloadPath": f"/internal/attachments/{pid}"}
+
+
+COMMAND = {
+    "eventId": str(uuid.uuid4()), "eventType": "DIAGNOSIS_REQUESTED", "schemaVersion": 2,
+    "occurredAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
+    "repairId": TASK, "taskId": TASK, "correlationId": str(uuid.uuid4()), "inputRevision": 1,
+    "executionId": str(uuid.uuid4()), "sequence": 0,
+    "payload": {
+        "repair": {"id": TASK, "symptom": "충전이 안 되고 바퀴 모터에서 소음. 펌웨어 업데이트 후부터 그렇다고 함",
+                   "error_codes": ["E05"], "firmware_version": "1.2", "user_input": {}},
+        "task": {"id": TASK},
+        "attachments": [photo("1", "PCB"), photo("2", "MECHANICAL")],
+        "attachmentIds": ["1", "2"], "addedAttachmentIds": [], "requestId": None, "requestKey": None,
+        "round": 0, "checkpoint": None,
+    },
+}
+
+
+async def main():
+    consumer = AIOKafkaConsumer(EVENTS_TOPIC, bootstrap_servers=KAFKA, group_id=f"test-{uuid.uuid4()}")
+    await consumer.start()
+    await asyncio.sleep(2)
+    producer = AIOKafkaProducer(bootstrap_servers=KAFKA)
+    await producer.start()
+    await producer.send_and_wait(COMMANDS_TOPIC, json.dumps(COMMAND).encode(), key=TASK.encode())
+    await producer.stop()
+    print(f"보냄: DIAGNOSIS_REQUESTED task {TASK}\n")
+    ok = False
+    async with asyncio.timeout(240):
+        async for msg in consumer:
+            e = json.loads(msg.value)
+            if e["taskId"] != TASK:
+                continue
+            jsonschema.validate(e, SCHEMA)
+            p = e["payload"]
+            print(f"#{e['sequence']} {e['eventType']:20} {p.get('stage') or p.get('mcpServer') or p.get('errorCode') or ''}")
+            if e["eventType"] in FINAL:
+                print("\n최종 결과:\n" + json.dumps(p, ensure_ascii=False, indent=2))
+                ok = e["eventType"] == "DIAGNOSIS_COMPLETED"
+                break
+    await consumer.stop()
+    print(f"\n계약 검사 통과 · 리포트: .local/reports/task-{TASK}_고장리포트.md")
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
diff --git a/app/kafka_worker.py b/app/kafka_worker.py
new file mode 100644
index 0000000..5a885fd
--- /dev/null
+++ b/app/kafka_worker.py
@@ -0,0 +1,104 @@
+"""Kafka 워커 (skeleton-agent에서 가져옴). 실행: uv run --extra live python -m app.kafka_worker
+
+diagnosis.commands.v2 → BackendCommand 검증 → 기존 EventProcessor(SQLite 중복 방지·상태 저장)
+→ 저장된 v2 결과 이벤트를 diagnosis.events.v2로 발행 → 리포트 md 저장 → 그다음 commit.
+같은 명령이 다시 오면 EventProcessor가 저장된 결과를 돌려주므로 같은 eventId로 재발행된다(Spring이 중복 제거).
+"""
+import asyncio
+import json
+import os
+from datetime import datetime, timezone
+from uuid import uuid4
+from aiokafka import AIOKafkaConsumer, AIOKafkaProducer
+from pydantic import ValidationError
+from app import report_md
+from app.backend_v2 import BackendCommand, ContractPending, process_backend_command
+from app.limits import DEFAULT_GRAPH_STEP_LIMIT
+from app.observability import configure_logging, log_event
+from app.service import EventConflict, EventProcessor
+from app.workflow import build_graph
+
+KAFKA = os.getenv("KAFKA_BOOTSTRAP_SERVERS", "localhost:9092")
+COMMANDS_TOPIC = "diagnosis.commands.v2"
+EVENTS_TOPIC = "diagnosis.events.v2"
+DLT_TOPIC = "diagnosis.commands.v2.dlt"
+GROUP_ID = os.getenv("GROUP_ID", "langgraph-diagnosis-v2")
+
+
+def make_processor():
+    mode = os.getenv("AGENT_TOOL_MODE", "live")
+    if mode == "live":
+        from app.live import gpt_report_writer, live_tools
+        tools, writer = live_tools(), gpt_report_writer
+    else:
+        from app.pcb import configured_tools
+        tools, writer = configured_tools(), None
+    graph = build_graph(tools, report_writer=writer)
+    return EventProcessor(graph, os.getenv("AGENT_STATE_PATH", ".local/agent-state.sqlite3"),
+                          DEFAULT_GRAPH_STEP_LIMIT, mode=getattr(tools, "mode", "mock"))
+
+
+def rejected_event(command: dict, code: str) -> dict:
+    """처리 전에 거부한 명령도 Spring이 RUNNING에 멈추지 않게 실패 이벤트를 만든다."""
+    return {"eventId": str(uuid4()), "eventType": "DIAGNOSIS_FAILED", "schemaVersion": 2,
+            "occurredAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
+            **{k: command[k] for k in ("repairId", "taskId", "correlationId", "inputRevision", "executionId")},
+            "sequence": 1, "payload": {"errorCode": code}}
+
+
+async def handle(raw: bytes, processor, producer):
+    async def publish(event):
+        await producer.send_and_wait(EVENTS_TOPIC, json.dumps(event, ensure_ascii=False).encode(),
+                                     key=str(event["taskId"]).encode())
+    try:
+        body = json.loads(raw)
+        command = BackendCommand.model_validate(body)
+    except (ValueError, ValidationError) as exc:  # 깨진 JSON·계약 위반 → DLT만 (taskId를 믿을 수 없음)
+        log_event("kafka.invalid_command", error_type=type(exc).__name__)
+        await producer.send_and_wait(DLT_TOPIC, raw)
+        return
+    try:
+        response = await asyncio.to_thread(process_backend_command, processor, command)
+    except ContractPending as exc:  # 팀 합의 대기 항목 → 실패 이벤트 + DLT
+        log_event("kafka.contract_pending", task_id=command.taskId, contract_field=exc.field)
+        await publish(rejected_event(body, f"CONTRACT_PENDING:{exc.field}"))
+        await producer.send_and_wait(DLT_TOPIC, raw, key=command.taskId.encode())
+        return
+    except EventConflict as exc:
+        log_event("kafka.event_conflict", task_id=command.taskId, reason=str(exc))
+        await producer.send_and_wait(DLT_TOPIC, raw, key=command.taskId.encode())
+        return
+    except Exception as exc:  # 예상 못 한 오류 → 실패 이벤트 + DLT
+        log_event("kafka.processing_error", task_id=command.taskId, error_type=type(exc).__name__)
+        await publish(rejected_event(body, "AGENT_ERROR"))
+        await producer.send_and_wait(DLT_TOPIC, raw, key=command.taskId.encode())
+        return
+    for event in response.get("backend_events", []):
+        await publish(event)
+    path = report_md.save(response)
+    log_event("kafka.published", task_id=command.taskId, status=response["status"],
+              event_count=len(response.get("backend_events", [])), report=str(path))
+
+
+async def run():
+    configure_logging()
+    processor = make_processor()
+    consumer = AIOKafkaConsumer(COMMANDS_TOPIC, bootstrap_servers=KAFKA, group_id=GROUP_ID,
+                                enable_auto_commit=False, auto_offset_reset="earliest")
+    producer = AIOKafkaProducer(bootstrap_servers=KAFKA, acks="all", enable_idempotence=True)
+    await consumer.start()
+    await producer.start()
+    log_event("kafka.ready", topic=COMMANDS_TOPIC, bootstrap=KAFKA, group=GROUP_ID,
+              gpt=bool(os.getenv("OPENAI_API_KEY")), mode=processor.mode)
+    try:
+        async for msg in consumer:
+            await handle(msg.value, processor, producer)
+            await consumer.commit()  # 발행·저장이 끝난 뒤에만 commit
+    finally:
+        await consumer.stop()
+        await producer.stop()
+        processor.close()
+
+
+if __name__ == "__main__":
+    asyncio.run(run())
