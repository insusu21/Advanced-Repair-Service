diff --git a/tests/test_live.py b/tests/test_live.py
new file mode 100644
index 0000000..4b947e7
--- /dev/null
+++ b/tests/test_live.py
@@ -0,0 +1,88 @@
+"""skeleton 통합분(app/live.py, kafka_worker, report_md) 단위 테스트. 네트워크·모델·API 키 없이 실행."""
+import json
+from pathlib import Path
+import jsonschema
+import pytest
+from app import live, report_md
+from app.adapters import MockTools
+from app.kafka_worker import rejected_event
+from app.service import EventProcessor
+from app.workflow import build_graph
+from app.models import DiagnosisEvent
+
+SCHEMA = json.loads(Path("tests/fixtures/backend-v2.schema.json").read_text())
+REQUEST = {"task_id": "t1", "case_id": "c1", "event_id": "e1", "round_no": 0, "symptom": "바퀴 소음",
+           "attachments": [{"photo_id": "2", "target": "MECHANICAL"}]}
+
+
+def test_photo_falls_back_to_sample_when_spring_is_down(monkeypatch, tmp_path):
+    monkeypatch.setattr(live, "SPRING_URL", "http://127.0.0.1:1")
+    assert live.fetch_photo("7", "PCB", tmp_path) == live.SAMPLES["PCB"]
+    assert live.fetch_photo("8", "MECHANICAL", tmp_path) == live.SAMPLES["MECHANICAL"]
+    assert all(p.is_file() for p in live.SAMPLES.values())
+
+
+def fake_mech(defects_by_tool):
+    def call(url, tool, args, timeout=60):
+        return {"defects": defects_by_tool[tool], "annotated_image": f"/tmp/{tool}.jpg", "model": "m"}
+    return call
+
+
+def test_mechanical_merges_surface_and_dent(monkeypatch):
+    monkeypatch.setattr(live, "SPRING_URL", "http://127.0.0.1:1")
+    monkeypatch.setattr(live, "call_http_mcp", fake_mech({
+        "detect_surface_defects": [{"type": "patches", "confidence": 0.8, "box_xyxy": [0, 0, 1, 1]}],
+        "detect_dents": [{"type": "dent", "confidence": 0.6, "box_xyxy": [0, 0, 2, 2]}]}))
+    out = live.LiveTools(pcb_client=None).analyze("MECHANICAL", REQUEST)
+    assert out["sufficient"] and out["confidence"] == 0.6
+    assert out["defect_counts"] == {"patches": 1, "dent": 1}
+    assert out["evidence_ids"] == ["2"] and out["mode"] == "live"
+
+
+def test_mechanical_rejects_unknown_label(monkeypatch):
+    monkeypatch.setattr(live, "SPRING_URL", "http://127.0.0.1:1")
+    monkeypatch.setattr(live, "call_http_mcp", fake_mech({
+        "detect_surface_defects": [{"type": "front-bumper-dent", "confidence": 0.8, "box_xyxy": [0, 0, 1, 1]}],
+        "detect_dents": []}))
+    with pytest.raises(live.MechToolError):
+        live.LiveTools(pcb_client=None).analyze("MECHANICAL", REQUEST)
+
+
+def test_rag_down_returns_empty_sources(monkeypatch):
+    def down(*args, **kwargs):
+        raise ConnectionError("down")
+    monkeypatch.setattr(live, "call_http_mcp", down)
+    assert live.LiveTools(pcb_client=None).search("바퀴 소음") == []
+    with pytest.raises(ConnectionError):
+        live.LiveTools(pcb_client=None, rag_optional=False).search("바퀴 소음")
+
+
+def test_report_writer_hook_keeps_scores_and_evidence():
+    def writer(request, report):
+        out = dict(report, summary="요약", candidates=[dict(c) for c in report["candidates"]])
+        for c in out["candidates"]:
+            c["repair_guide"], c["confidence"] = "점검", 0.0  # confidence 변경은 workflow 검증 대상이 아니라 writer 책임
+        return out
+    processor = EventProcessor(build_graph(MockTools(), report_writer=writer))
+    result = processor.process(DiagnosisEvent(event_id="e1", event_type="DIAGNOSIS_REQUESTED", task_id="t1",
+                                              case_id="c1", symptom="소음",
+                                              attachments=[{"photo_id": "p1", "target": "MECHANICAL"}]))
+    assert result["status"] == "SUCCEEDED"
+    assert result["report"]["summary"] == "요약"
+    assert result["report"]["candidates"][0]["repair_guide"] == "점검"
+
+
+def test_rejected_event_matches_v2_schema():
+    command = {"repairId": "1", "taskId": "1", "correlationId": "90000000-0000-0000-0000-000000000001",
+               "inputRevision": 1, "executionId": "a0000000-0000-0000-0000-000000000003"}
+    jsonschema.validate(rejected_event(command, "CONTRACT_PENDING:attachment.target"), SCHEMA)
+
+
+def test_report_markdown_is_written(tmp_path, monkeypatch):
+    monkeypatch.setattr(report_md, "OUT", tmp_path)
+    processor = EventProcessor(build_graph(MockTools()))
+    response = processor.process(DiagnosisEvent(event_id="e2", event_type="DIAGNOSIS_REQUESTED", task_id="t2",
+                                                case_id="c2", symptom="소음",
+                                                attachments=[{"photo_id": "p1", "target": "PCB"}]))
+    text = report_md.save(response).read_text()
+    assert "진단 완료" in text and "원인 후보" in text and "PCB 사진 p1" in text
