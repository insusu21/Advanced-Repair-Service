@@ -0,0 +1,177 @@
+"""skeleton-agent에서 가져온 실제 도구: Spring 사진 다운로드, 기계 MCP, RAG MCP, GPT 리포트 문장.
+
+기존 구조(MockTools/PCBTools 출력 모양, workflow 재시도·상한, Pydantic 검증)는 그대로 쓴다.
+- PCB: 기존 PCBTools 검증을 그대로 거친다. 사진 경로만 여기서 준비한다.
+- 기계: mechanical-mcp(HTTP) 표면 결함 + 찌그러짐 두 도구.
+- RAG: Rag_mcp의 retrieve_repair_context(HTTP). 서버가 꺼져 있으면 빈 검색으로 진행.
+- GPT: 리포트 문장(요약·원인 설명·수리 방법)만 쓴다. 확신도·근거 사진은 코드가 정한 값을 유지한다.
+"""
+import asyncio
+import json
+import math
+import os
+import sys
+import tempfile
+from pathlib import Path
+from app.adapters import MockTools
+from app.observability import context, log_event
+from app.pcb import PCBClient, PCBTools, PCBToolError
+
+HERE = Path(__file__).parent
+SPRING_URL = os.getenv("SPRING_BASE_URL", "http://localhost:8080")
+SPRING_TOKEN = os.getenv("INTERNAL_SERVICE_TOKEN", "")
+MECH_MCP_URL = os.getenv("MECH_MCP_URL", "http://127.0.0.1:9104/mcp")
+RAG_MCP_URL = os.getenv("RAG_MCP_URL", "http://127.0.0.1:8014/mcp")
+GPT_MODEL = os.getenv("GPT_MODEL", "gpt-4o-mini")
+# Spring에서 사진을 못 받으면 쓰는 예시 사진 (사용자 지정: 기본으로 들고 있는 예시 2장)
+SAMPLES = {"PCB": HERE / "samples/pcb_sample.jpg", "MECHANICAL": HERE / "samples/mech_sample.jpg"}
+MECH_MIN_CONF = 0.5  # 기계 박스 최소 확신도. 이보다 낮은 박스는 버린다
+SURFACE = {"crazing", "inclusion", "patches", "pitted_surface", "rolled-in_scale", "scratches"}
+DENT = {"dent", "breakage"}
+
+
+class MechToolError(ValueError):
+    """재시도로 해결되지 않는 기계 MCP 응답 오류."""
+
+
+def fetch_photo(photo_id: str, target: str, folder: Path) -> Path:
+    """Spring /internal/attachments/{id}에서 사진을 받는다. 실패하면 target에 맞는 예시 사진."""
+    import httpx
+    try:
+        r = httpx.get(f"{SPRING_URL}/internal/attachments/{photo_id}",
+                      headers={"Authorization": f"Bearer {SPRING_TOKEN}"}, timeout=10)
+        r.raise_for_status()
+        path = folder / f"{photo_id}.jpg"
+        path.write_bytes(r.content)
+        return path
+    except Exception as exc:
+        log_event("photo.sample_used", photo_id=photo_id, target=target, reason=type(exc).__name__)
+        return SAMPLES[target]
+
+
+def call_http_mcp(url: str, tool: str, args: dict, timeout=60) -> dict:
+    """mcp 1.x Streamable HTTP 클라이언트로 도구 한 번 호출. 오류는 workflow 재시도 규칙에 맞는 예외로 바꾼다."""
+    async def run():
+        from mcp import ClientSession
+        from mcp.client.streamable_http import streamablehttp_client
+        async with streamablehttp_client(url, timeout=timeout) as (read, write, _):
+            async with ClientSession(read, write) as session:
+                await session.initialize()
+                res = await session.call_tool(tool, args)
+                if res.isError:
+                    raise ValueError(f"{tool} returned a tool error")
+                return res.structuredContent or json.loads(res.content[0].text)
+    try:
+        return asyncio.run(asyncio.wait_for(run(), timeout))
+    except TimeoutError:
+        raise
+    except BaseExceptionGroup as exc:  # 연결 거부 등은 AnyIO가 감싸서 올린다
+        if any(isinstance(e, (OSError, ConnectionError)) or "connect" in type(e).__name__.lower()
+               for e in exc.exceptions):
+            raise ConnectionError(f"{url} 연결 실패") from exc
+        raise ValueError(f"{tool} MCP session failed") from exc
+
+
+class LiveTools(MockTools):
+    mode = "mixed"  # DiagnosisReport.mode 허용값(mock/mixed)을 따른다
+
+    def __init__(self, pcb_client: PCBClient, rag_optional=True):
+        self.pcb_client = pcb_client
+        self.rag_optional = rag_optional
+
+    def _paths(self, domain, request):
+        folder = Path(tempfile.mkdtemp(prefix=f"task{request['task_id']}_"))
+        return {a["photo_id"]: str(fetch_photo(a["photo_id"], domain, folder))
+                for a in request["attachments"] if a["target"] == domain}
+
+    def analyze(self, domain, request):
+        if domain == "PCB":
+            # 기존 PCBTools 검증(라벨·점수·박스·요약 일치)을 그대로 쓴다
+            return PCBTools(self.pcb_client, self._paths("PCB", request)).analyze("PCB", request)
+        photo = [a for a in request["attachments"] if a["target"] == "MECHANICAL"][-1]
+        path = self._paths("MECHANICAL", request)[photo["photo_id"]]
+        log_event("mcp.call_started", **context(request), server="mechanical-mcp", transport="http",
+                  tool="detect_surface_defects+detect_dents", mode_detail="live")
+        surface = call_http_mcp(MECH_MCP_URL, "detect_surface_defects", {"photo_id": path, "conf": MECH_MIN_CONF})
+        dent = call_http_mcp(MECH_MCP_URL, "detect_dents", {"photo_id": path, "conf": MECH_MIN_CONF})
+        defects = []
+        for raw, allowed in ((surface, SURFACE), (dent, DENT)):
+            for item in raw.get("defects", []):
+                score, box = item.get("confidence"), item.get("box_xyxy")
+                if (item.get("type") not in allowed or type(score) not in (float, int) or not math.isfinite(score)
+                        or not 0 <= score <= 1 or not isinstance(box, list) or len(box) != 4):
+                    raise MechToolError("Invalid mechanical detection")
+                defects.append(item)
+        counts = {}
+        for item in defects:
+            counts[item["type"]] = counts.get(item["type"], 0) + 1
+        # PCB와 같은 규칙: 최소 박스 점수. 고장 원인 확률이 아니다
+        confidence = min((d["confidence"] for d in defects), default=0.0)
+        finding = ("기계 부품 결함 검출: " + ", ".join(f"{k} {v}개" for k, v in counts.items())
+                   if defects else "결함 미검출. 정상 여부·고장 원인은 추가 확인 필요")
+        log_event("mcp.call_completed", **context(request), server="mechanical-mcp",
+                  defect_count=len(defects), defect_counts=counts, detection_score=confidence)
+        return {"domain": "MECHANICAL", "sufficient": bool(defects), "confidence": confidence,
+                "finding": finding, "evidence_ids": [photo["photo_id"]],
+                "annotated_image": surface.get("annotated_image"), "dent_image": dent.get("annotated_image"),
+                "defects": defects, "defect_counts": counts, "mode": "live", "mcp_server": "mechanical-mcp",
+                "tool_version": "detect_surface_defects+detect_dents-v1", "model_version": surface.get("model", ""),
+                "score_kind": "minimum_box_confidence", "diagnosis_confirmed": False}
+
+    def search(self, symptom):
+        """Rag_mcp 과거 수리 사례·라벨 정의. 찌그러짐 라벨은 보내지 않는다(자동차 경고가 GPT로 들어가는 것 방지)."""
+        request = {"raw_text": symptom, "origin": "technician", "technician_confirmed": True,
+                   "pcb_labels": [], "damage_labels": [], "top_k": 3}
+        try:
+            d = call_http_mcp(RAG_MCP_URL, "retrieve_repair_context", {"request": request})
+        except ConnectionError:
+            if not self.rag_optional:
+                raise
+            log_event("rag.unavailable", url=RAG_MCP_URL)
+            return []
+        sources = [{"source_uri": x["source_url"] + "#" + x["source_id"], "source_version": x.get("source_sha256", "")[:12],
+                    "excerpt": (x.get("korean_summary") or x.get("chunk_text") or "")[:300]} for x in d["repair_cases"]]
+        sources += [{"source_uri": "rag://" + x["document_id"], "source_version": "label-definition",
+                     "excerpt": x["title"]} for x in d["label_definitions"]]
+        return sources
+
+
+def gpt_report_writer(request, report):
+    """GPT가 리포트 문장만 쓴다. 후보 개수·순위·확신도·근거는 바꾸지 않는다."""
+    if not os.getenv("OPENAI_API_KEY"):
+        return report
+    from langchain_openai import ChatOpenAI
+    from pydantic import BaseModel, Field
+
+    class Item(BaseModel):
+        rank: int
+        cause_description: str = Field(description="이 후보의 원인 설명 한두 문장")
+        repair_guide: str = Field(description="기사가 할 점검·수리 방법")
+
+    class Written(BaseModel):
+        summary: str = Field(description="전체 진단 요약 2~3문장")
+        items: list[Item]
+
+    facts = [{"rank": c["rank"], "finding": c["evidence"]["finding"], "detection_score": c["confidence"],
+              "similar_cases": [m["excerpt"] for m in c["evidence"]["manuals"]][:3]} for c in report["candidates"]]
+    rules = ("너는 로봇청소기 수리 진단 리포트 작성자다. 아래 규칙은 지키되 리포트에 규칙 문장을 옮겨 쓰지 마라.\n"
+             "1. finding은 이 로봇청소기 부품 사진의 검출 결과다. 결과를 근거로 원인을 설명한다.\n"
+             "2. similar_cases는 다른 기기의 과거 수리 기록이다. 쓸 때는 '과거 유사 사례에서는 …'처럼 쓴다.\n"
+             "3. detection_score는 박스 검출 점수이지 고장 확률이 아니다. 확정 진단처럼 쓰지 않는다.\n"
+             "4. cause_description은 finding을 그대로 베끼지 말고, 그 결함이 증상과 어떻게 이어질 수 있는지 설명한다.")
+    prompt = [("system", rules),
+              ("user", f"증상: {request['symptom']}\n후보: {json.dumps(facts, ensure_ascii=False)}")]
+    written = ChatOpenAI(model=GPT_MODEL, temperature=0).with_structured_output(Written).invoke(prompt)
+    by_rank = {i.rank: i for i in written.items}
+    out = dict(report, summary=written.summary, candidates=[dict(c) for c in report["candidates"]])
+    for c in out["candidates"]:
+        if c["rank"] in by_rank:
+            c["cause_description"] = by_rank[c["rank"]].cause_description
+            c["repair_guide"] = by_rank[c["rank"]].repair_guide
+    return out
+
+
+def live_tools():
+    return LiveTools(PCBClient(os.getenv("PCB_MCP_SCRIPT", ".local/vendor/MCP_Error_check/pcb_agent/mcp_server.py"),
+                               python=os.getenv("PCB_MCP_PYTHON", sys.executable),
+                               timeout=float(os.getenv("PCB_MCP_TIMEOUT", "35"))))
