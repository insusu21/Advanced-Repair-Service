+"""처리 결과를 사람이 읽는 고장 리포트 Markdown으로 저장한다 (skeleton-agent에서 가져옴).
+
+저장 위치: .local/reports/task-{task_id}_고장리포트.md (Git 제외)
+"""
+from datetime import datetime
+from pathlib import Path
+
+OUT = Path(".local/reports")
+TITLE = {"SUCCEEDED": "진단 완료", "WAITING_INPUT": "추가 자료 요청", "FAILED": "진단 실패"}
+
+
+def image(path):
+    return f"![{Path(path).name}]({Path(path).resolve().as_uri()})" if path and Path(path).is_file() else None
+
+
+def save(response: dict) -> Path:
+    req, report = response["request"], response.get("report")
+    ctx = req.get("source_context") or {}
+    repair = ctx.get("payload", {}).get("repair", {})
+    lines = [f"# 고장 리포트: 접수 {req['case_id']} ({TITLE.get(response['status'], response['status'])})", "",
+             f"- 작성: {datetime.now():%Y-%m-%d %H:%M} · 모드 {response.get('mode')}",
+             f"- 증상: {req['symptom']}",
+             f"- 에러코드: {', '.join(repair.get('error_codes') or []) or '-'} · 펌웨어 {repair.get('firmware_version') or '-'}",
+             f"- 사진: {', '.join(a['photo_id'] + '(' + a['target'] + ')' for a in req['attachments'])}", ""]
+    if report:
+        lines += ["## 요약", "", report.get("summary") or "-", "",
+                  "## 원인 후보", "", "| 순위 | 원인 | 검출 점수 | 설명 | 수리 방법 |", "|---|---|---|---|---|"]
+        lines += [f"| {c['rank']} | {c['cause_code']} | {c['confidence']:.2f} | {c['cause_description']} | {c['repair_guide']} |"
+                  for c in report["candidates"]]
+        lines += ["", "## 근거", ""]
+        for result in response.get("results", []):
+            lines += [f"### {result['domain']} 사진 {', '.join(result['evidence_ids'])}", "", result["finding"], ""]
+            lines += [x for x in (image(result.get("annotated_image")), image(result.get("dent_image"))) if x]
+            lines += [""]
+        manuals = report["candidates"][0]["evidence"]["manuals"] if report["candidates"] else []
+        if manuals:
+            lines += ["### 과거 유사 사례·참고 문서 (RAG)", ""]
+            lines += [f"- {m['excerpt']} ({m['source_uri']})" for m in manuals]
+    else:
+        event = response.get("outgoing_event") or {}
+        lines += ["## 결과", "", f"- {event.get('event_type')}: {event.get('payload')}"]
+    OUT.mkdir(parents=True, exist_ok=True)
+    path = OUT / f"task-{req['task_id']}_고장리포트.md"
+    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return path
