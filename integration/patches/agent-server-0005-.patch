+def recommend_parts(candidates):
+    """[통합] 추천 부품: 백엔드 기존 내부 API /internal/parts 목록에서 검출 후보 부위(PCB/MOTOR)와 category가 같은 부품을 1개씩.
+    사례 기반 후보는 부품을 특정하지 못해 뺀다. Spring이 없거나 맞는 부품이 없으면 빈 목록."""
+    import httpx
+    try:
+        parts = httpx.get(f"{SPRING_URL}/internal/parts", headers={"Authorization": f"Bearer {SPRING_TOKEN}"}, timeout=10).json()
+    except (httpx.HTTPError, ValueError):
+        return []
+    picked = []
+    for c in candidates:
+        domain = c["cause_code"].split("_", 1)[0]
+        part = next((p for p in parts if p.get("category") == domain), None)
+        if c.get("score_kind", "DETECTION") == "DETECTION" and part and str(part["id"]) not in [x["partId"] for x in picked]:
+            picked.append({"partId": str(part["id"]), "quantity": 1})
+    return picked
+
+
 def gpt_report_writer(request, report):
     """GPT가 문장만 쓴다: 원인 이름·설명·수리 방법, 요약, 긴급도, 점검 순서, 수리 순서, 사례 번역, 사례 기반 후보 1개.
     검출 후보의 순위·점수·근거 사진은 코드가 정한 값을 그대로 둔다."""
@@ -159,6 +176,7 @@ def gpt_report_writer(request, report):
     report = dict(report, similar_cases=[
         {"caseId": m["case_id"], "summaryKo": None, "originalText": m["excerpt"], "origin": "EXTERNAL",
          "similarity": m.get("similarity"), "sourceUri": m["source_uri"]} for m in cases])
+    report["recommended_parts"] = recommend_parts(report["candidates"])
     if not os.getenv("OPENAI_API_KEY"):
         return report
     from typing import Literal
