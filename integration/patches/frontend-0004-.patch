diff --git a/src/api/adapters/repair.ts b/src/api/adapters/repair.ts
index 496521d..edc008d 100644
--- a/src/api/adapters/repair.ts
+++ b/src/api/adapters/repair.ts
@@ -55,7 +55,10 @@ export function latestTask(tasks: BeTask[] | undefined): BeTask | undefined {
 /** 진단 작업 → 진행 단계 표시. 백엔드 stage 가 프론트 단계 이름과 같으면 그 위치를 쓰고, 아니면 상태로 추정 */
 function toStages(task: BeTask | undefined): { stages: AnalysisStageState[]; progress: number } {
   if (!task) return { stages: STAGE_ORDER.map((stage) => ({ stage, state: 'PENDING' })), progress: 0 }
-  const stage = (task.stage ?? '').toUpperCase() as AnalysisStage
+  // [통합] 에이전트 단계 이름 → 화면 단계 (사진 분류·소견 분리 = 준비, 판단 = 종합). 나머지는 같은 이름으로 온다
+  const ALIAS: Record<string, AnalysisStage> = { CLASSIFYING_PHOTOS: 'ORCHESTRATION', SPLITTING_TEXT: 'ORCHESTRATION', JUDGING: 'SYNTHESIS' }
+  const raw = (task.stage ?? '').toUpperCase()
+  const stage = (ALIAS[raw] ?? raw) as AnalysisStage
   const known = STAGE_ORDER.indexOf(stage)
   const cur = known >= 0 ? known : task.status === 'QUEUED' ? 0 : 1
   if (task.status === 'SUCCEEDED') return { stages: STAGE_ORDER.map((s) => ({ stage: s, state: 'DONE' })), progress: 100 }
