diff --git a/src/main/java/com/skala/backend/repair/ApiController.java b/src/main/java/com/skala/backend/repair/ApiController.java
index 42d727e..4ff4489 100644
--- a/src/main/java/com/skala/backend/repair/ApiController.java
+++ b/src/main/java/com/skala/backend/repair/ApiController.java
@@ -31,6 +31,8 @@ public class ApiController {
     @GetMapping("/tasks/{id}") public Map<String,Object> task(@PathVariable Long id) {return queries.task(id);}
     @PostMapping("/photo-requests/{id}/submit") public ResponseEntity<?> submit(@PathVariable Long id,@Valid @RequestBody Inputs.PhotoSubmission input) {return ResponseEntity.accepted().body(repairs.resume(queries.requestRepairId(id),new Inputs.Resume(id,input.submissionKey(),input.attachmentIds())));}
     @PostMapping("/repairs/{id}/report") public Map<String,Object> saveAndConfirm(@PathVariable Long id,@Valid @RequestBody Inputs.Draft input) {return reports.saveAndConfirm(id,input);}
+    // [통합 추가] 진단 확인·반려·본사 검토 (RepairService.approval 참고)
+    @PostMapping("/repairs/{id}/approval") public Map<String,Object> approval(@PathVariable Long id,@Valid @RequestBody Inputs.Approval input) {repairs.approval(id,input);return queries.detail(id);}
     @GetMapping("/repairs/{id}/diagnosis") public Map<String,Object> diagnosis(@PathVariable Long id) {return queries.diagnosis(id);}
     @GetMapping("/repairs/{id}/diagnosis/tools") public List<Map<String,Object>> tools(@PathVariable Long id) {return queries.tools(id);}
     @PostMapping(value="/repairs/{id}/attachments",consumes=MediaType.MULTIPART_FORM_DATA_VALUE)
diff --git a/src/main/java/com/skala/backend/repair/Inputs.java b/src/main/java/com/skala/backend/repair/Inputs.java
index 287eac7..a73d606 100644
--- a/src/main/java/com/skala/backend/repair/Inputs.java
+++ b/src/main/java/com/skala/backend/repair/Inputs.java
@@ -24,5 +24,7 @@ public final class Inputs {
     public enum Source { WAREHOUSE, FACTORY }
     public record Item(@NotNull Long partId,@Min(1) int quantity,@NotNull Source source,Long warehouseId,Long factoryId) {}
     public record Proposal(@NotEmpty @Valid List<Item> items) {}
+    // [통합 추가] 기사 진단 확인·반려·본사 검토 요청, 본사 수동 진단 회신. 프론트가 원래 쓰던 POST /repairs/{id}/approval 본문 그대로
+    public record Approval(@NotBlank @Pattern(regexp="DIAGNOSIS|MANUAL_REVIEW") String target,@NotBlank @Pattern(regexp="APPROVE|REJECT|REQUEST_HQ_REVIEW|RETURN_TO_TECHNICIAN") String action,@Size(max=4000) String comment) {}
     public record Decision(@NotBlank @Size(max=2000) String reason) {}
 }
diff --git a/src/main/java/com/skala/backend/repair/RepairService.java b/src/main/java/com/skala/backend/repair/RepairService.java
index 23c3416..95fabce 100644
--- a/src/main/java/com/skala/backend/repair/RepairService.java
+++ b/src/main/java/com/skala/backend/repair/RepairService.java
@@ -73,6 +73,19 @@ public class RepairService {
         command(repair,(Long)task.get("id"),"DIAGNOSIS_RESUMED",input.requestId(),input.attachmentIds());db.event(repair,"DIAGNOSIS_RESUMED",Map.of("taskId",task.get("id")));
         return Map.of("repairId",repair,"taskId",task.get("id"),"inputRevision",Json.number(task.get("input_revision"))+1);
     }
+    // [통합 추가] 백엔드에 DIAGNOSED → REPAIRING 전이가 없어 프론트 리포트 화면(TECHNICIAN_REVIEW=REPAIRING)이 열리지 않던 문제.
+    // 확인·반려 모두 기사가 수리를 시작하는 것(AI 수용 여부는 리포트 aiAcceptance에 남는다). 본사 검토 요청은 MANUAL_REVIEW, 본사 회신은 다시 REPAIRING.
+    @Transactional public void approval(Long repair,Inputs.Approval input) {
+        boolean manual=input.target().equals("MANUAL_REVIEW");
+        if(manual) access.manager(); else access.technician();
+        access.repair(repair);var row=db.one("SELECT status FROM repair_case WHERE id=? FOR UPDATE",repair);
+        String from=manual?"MANUAL_REVIEW":"DIAGNOSED",to=input.action().equals("REQUEST_HQ_REVIEW")?"MANUAL_REVIEW":"REPAIRING";
+        if(manual!=input.action().equals("RETURN_TO_TECHNICIAN")) throw ApiError.bad("APPROVAL_ACTION_TARGET_MISMATCH");
+        if(!row.get("status").equals(from)) throw ApiError.conflict("NOT_"+from);
+        db.update("UPDATE repair_case SET status=?,version=version+1 WHERE id=?",to,repair);
+        var data=new LinkedHashMap<String,Object>();data.put("target",input.target());data.put("action",input.action());data.put("comment",input.comment());
+        db.event(repair,"APPROVAL_"+input.action(),data);db.audit(access.user().email,"APPROVAL_"+input.action(),repair,data);
+    }
     public Map<String,Object> analysisInput(Long repair,Long task) {
         var result=new LinkedHashMap<String,Object>();result.put("repair",db.one("SELECT * FROM repair_case WHERE id=?",repair));
         result.put("task",db.one("SELECT * FROM diagnosis_job WHERE id=? AND case_id=?",task,repair));
